<link rel="stylesheet" href="~/css/proyeccion.css"/>

<div class="container-fluid contenedor-proyeccion">
    <h4 class="titulo-proyeccion">Proyección por Semanas</h4>

    <div class="row panel-filtros">
        <div class="col-3">
            <input type="date" id="fechaDesde" class="form-control" />
        </div>
        <div class="col-3">
            <input type="date" id="fechaHasta" class="form-control" />
           
        </div>
        <div class="col-1">
            <button id="btnBuscar" class="btn btn-primary">Buscar</button>
           
        </div>
        <div class="col-2">
            <button id="btnGuardar" class="btn btn-success">Guardar cambios</button>
            <div class="mt-2">
                <small id="lblAutoSave" class="text-muted"> Sin guardar</small>
            </div>
        </div>
        @* <label>Saldo PP01 Mayor a</label> *@
        <div class="col-3">  
            @* <label>Saldo PP01 Mayor a</label> *@
            <div class="form-floating">
                <input type="number"
                       id="saldoPP01Minimo"
                       class="form-control"
                       value="0" />
                <label for="saldoPP01Minimo">Saldo mayor a</label>
            </div>
            
        </div>

    </div>
    @* <div class="col-md-2">

        <label>Saldo PP01 Mayor a</label>

        <input type="number"
               id="saldoPP01Minimo"
               class="form-control"
               value="0" />

    </div> *@

   

    <table id="tablaProyeccion" class="table table-bordered table-sm w-100" style="width:100%">
        <thead></thead>
        <tbody></tbody>
        <tfoot>
            <tr></tr>
        </tfoot>
    </table>


    <div class="toast-container position-fixed top-0 end-0 p-3">
        <div id="toastGuardado" class="toast text-white bg-success border-0" role="alert">
            <div class="toast-body">
                Proyeccion guardada automaticamente
            </div>
        </div>

    </div>

</div>


